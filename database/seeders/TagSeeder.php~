<?php

namespace Database\Seeders;

use App\Models\Tag;
use Illuminate\Database\Seeder;

class TagSeeder extends Seeder
{
	/**
	 * Run the database seeds.
	 *
	 * @return void
	 */
	public function run()
	{
		$tags = [
			'Laravel',
			'PHP',
			'JavaScript',
			'Vue.js',
			'React',
			'CSS',
			'HTML',
			'MySQL',
			'DevOps',
			'API'
		];

		foreach ($tags as $tagName) {
			Tag::create(['name' => $tagName]);
		}
	}
}